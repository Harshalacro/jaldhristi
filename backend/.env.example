# JalDrishti optional API keys. Copy to backend/.env and fill in any you have.
# Every key is optional: with none set the dashboard runs on keyless public data
# (Open-Meteo, GloFAS, Copernicus DEM, OpenStreetMap) and the AI features use
# deterministic, data-grounded fallbacks.

# --- LLM for the Copilot chat and advisory generator (any one is enough) ---
# Google Gemini - FREE tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq (Llama) - FREE tier, no card: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude - paid, best answer quality: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Which to prefer when several are set: auto | anthropic | gemini | groq
# JALDRISHTI_LLM_PROVIDER=auto

# --- Second rainfall forecast for multi-model consensus ---
# OpenWeatherMap - FREE, 1,000 calls/day, no card: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
